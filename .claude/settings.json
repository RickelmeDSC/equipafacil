{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(*push*--force*)",
      "Bash(*push* -f*)",
      "Bash(*push*--mirror*)",
      "Bash(*push* +*)",
      "Bash(*push* main)",
      "Bash(*push*:main)",
      "Bash(*push*:refs/heads/main)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "PowerShell(*push*--force*)",
      "PowerShell(*push* -f*)",
      "PowerShell(*push*--mirror*)",
      "PowerShell(*push* +*)",
      "PowerShell(*push* main)",
      "PowerShell(*push*:main)",
      "PowerShell(*push*:refs/heads/main)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)"
    ],
    "ask": [
      "Bash(*push*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(neonctl *)",
      "Bash(render *)",
      "PowerShell(*push*)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(gh)",
      "PowerShell(gh *)",
      "PowerShell(curl *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(neonctl *)",
      "PowerShell(render *)"
    ]
  }
}
