# Modelo de configuração local do EquipaFácil.
# Copie para .env (nunca versionado) e ajuste. Todos os valores abaixo são fictícios.
# Uma variável por linha, no formato CHAVE=valor; não use comentário na mesma linha do valor.

# Chave secreta: gere uma chave própria (veja o README). Não reutilize este valor.
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-localmente

# True somente no desenvolvimento local.
DJANGO_DEBUG=True

# Hosts aceitos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF, separadas por vírgula (ex.: https://exemplo.test). Vazio no desenvolvimento local.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados: postgresql (banco-alvo do projeto) ou sqlite.
# sqlite é TEMPORÁRIO, só para desenvolvimento local, e exige DJANGO_DEBUG=True.
DB_ENGINE=sqlite

# PostgreSQL: usado quando DB_ENGINE=postgresql. Valores fictícios.
# Prefira deixar DB_PASSWORD vazio e guardar a senha no pgpass.conf (docs/postgresql-local.md).
DB_NAME=equipafacil_dev
DB_USER=equipafacil_dev
DB_PASSWORD=
# Use o mesmo host da linha do pgpass.conf (127.0.0.1, não localhost).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# Segurança fora do desenvolvimento (definição final em DEV-08).
# Com DJANGO_DEBUG=False, cookies seguros e redirecionamento para HTTPS ficam ativos por padrão.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_PROXY_SSL_HEADER=False
